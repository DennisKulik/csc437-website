{
	"name": "server",
	"version": "1.0.0",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"dev": "nodemon",
		"build": "npx tsc",

		"start": "npm run build && npm run start:node",
		"start:node": "node dist/index.js",

		"start:api": "cross-env STATIC=./public npm run start",
		"start:app": "cross-env STATIC=../app/dist npm run start",
		"start:proto": "cross-env STATIC=../proto/dist npm run start",

		"start:api:win": "npm run build && set STATIC=./public&& node dist/index.js",
		"start:app:win": "npm run build && set STATIC=../app/dist&& node dist/index.js",
		"start:proto:win": "npm run build && set STATIC=../proto/dist&& node dist/index.js",

		"check": "tsc --noEmit"
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.6.2",
		"cross-env": "^10.1.0",
		"nodemon": "^3.1.14",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mongodb": "^7.2.0",
		"mongoose": "^9.6.2"
	}
}
